# App
# prod: https://postship.fr (never postship.app — taken by another product)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TOKENS_500=
STRIPE_PRICE_TOKENS_1000=
STRIPE_PRICE_TOKENS_5000=

# Email
RESEND_API_KEY=
RESEND_FROM=PostShip <alerts@localhost>

# Jobs
CRON_SECRET=

# Quick-connect OAuth for chat alerts (optional — without these, the
# "Connecter Discord" / "Connecter Slack" buttons return
# discord_not_configured / slack_not_configured and users fall back to
# pasting a webhook URL by hand).
# Discord: https://discord.com/developers/applications — OAuth2 redirect
# must be exactly <NEXT_PUBLIC_APP_URL>/api/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack: https://api.slack.com/apps — OAuth & Permissions redirect must be
# exactly <NEXT_PUBLIC_APP_URL>/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
