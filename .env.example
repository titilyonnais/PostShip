# App
# prod: https://postship.fr (never postship.app — taken by another product)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TOKENS_500=
STRIPE_PRICE_TOKENS_1000=
STRIPE_PRICE_TOKENS_5000=

# Email
RESEND_API_KEY=
RESEND_FROM=PostShip <alerts@localhost>

# Jobs
CRON_SECRET=

# Quick-connect OAuth for chat alerts (optional — without these, the
# "Connecter Discord" / "Connecter Slack" buttons return
# discord_not_configured / slack_not_configured and users fall back to
# pasting a webhook URL by hand).
# Discord: https://discord.com/developers/applications — OAuth2 redirect
# must be exactly <NEXT_PUBLIC_APP_URL>/api/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack: https://api.slack.com/apps — OAuth & Permissions redirect must be
# exactly <NEXT_PUBLIC_APP_URL>/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub App for the Checks integration (optional — without these the
# "Installer l'app GitHub" button returns github_not_configured and the
# fine-grained PAT path keeps working).
# https://github.com/settings/apps — permission Checks: Read and write,
# Setup URL <NEXT_PUBLIC_APP_URL>/api/oauth/github/callback with
# "Redirect on update" checked.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The generated .pem, whole. Literal \n sequences are accepted too.
GITHUB_APP_PRIVATE_KEY=

# Hidden operator page at /app/admin — comma-separated auth user ids.
# An env allowlist rather than a database column: any write path to
# "is admin" is a privilege-escalation surface.
ADMIN_USER_IDS=

# Optional, for the infrastructure panels on /app/admin. Each is missing
# by default and the panel says so rather than disappearing.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=

# Where the console sends its login alerts. Unset means no alert is sent —
# on a single-factor console that is the only way to notice a sign-in that
# wasn't you.
ADMIN_ALERT_EMAIL=
# A project-scoped Vercel token (vcp_…) is refused on account-level
# endpoints and only answers when the request names its team, so the team
# id is required in practice; the project id narrows the numbers to this
# project rather than everything sharing the team.
VERCEL_PROJECT_ID=
